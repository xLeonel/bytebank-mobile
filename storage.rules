rules_version = '2';

// Regras do Cloud Storage — recibos anexados às transações.
//
// Caminho: users/{uid}/receipts/{txId}/{arquivo}
// O uid no caminho é o que amarra o arquivo ao dono; sem isso qualquer usuário
// autenticado leria os comprovantes dos outros.
//
// Publicar com:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Limites no upload: sem teto, um arquivo grande consumiria a cota gratuita
    // do plano Blaze rapidamente — e é a cota que mantém o custo em zero.
    function tamanhoOk() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Lista fechada em vez de `image/.*`: SVG também é "imagem", e pode trazer
    // script embutido.
    function ehImagem() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    // Foto de perfil — só imagem.
    match /users/{uid}/avatar.jpg {
      allow read: if ehDono(uid);
      allow create, update: if ehDono(uid) && tamanhoOk() && ehImagem();
      allow delete: if ehDono(uid);
    }

    // Recibos de transação — imagem ou PDF.
    match /users/{uid}/receipts/{txId}/{arquivo} {
      allow read: if ehDono(uid);
      allow create, update: if ehDono(uid)
        && tamanhoOk()
        && (ehImagem() || request.resource.contentType == 'application/pdf');
      allow delete: if ehDono(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
