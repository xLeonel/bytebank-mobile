# Configuração do Firebase — copie para .env.local e preencha com os valores do
# seu projeto (console.firebase.google.com → Project settings → Your apps → Web).
#
# Registre um app do tipo *Web* mesmo usando o app em Android/iOS: com o Firebase
# JS SDK (o que este projeto usa, por rodar no Expo Go) a configuração web serve
# para todas as plataformas. App Android/iOS só é necessário com @react-native-firebase.
#
# O prefixo EXPO_PUBLIC_ embute o valor no bundle. Isso é esperado: chaves do SDK
# cliente do Firebase não são segredo — quem protege os dados são as Security
# Rules (firestore.rules). O .env.local fica fora do git só para o repositório
# não ficar preso a um projeto específico.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
